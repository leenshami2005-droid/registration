{
  "env": { "node": true, "es2021": true, "jest": true },
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "script" },
  "extends": "eslint:recommended",
  "rules": {
    "indent": ["error", 2],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": "error",
    "eqeqeq": "error"
  }
}
